{
  "manifest_version": 3,
  "name": "Amazon Order Exporter",
  "version": "1.0.0",
  "description": "Scrapes your Amazon.ae order history and exports it to an Excel file (.xlsx).",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Amazon Order Exporter"
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage"
  ],

  "host_permissions": [
    "https://www.amazon.ae/*"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "lib/xlsx.min.js",
        "utils/export-xlsx.js",
        "utils/dom-helpers.js",
        "utils/api-helpers.js",
        "utils/pagination.js",
        "config/regions.js",
        "config/patterns.js",
        "extractors/order-id.js",
        "extractors/order-type.js",
        "extractors/order-date.js",
        "extractors/item-description.js",
        "extractors/price.js",
        "extractors/quantity.js",
        "extractors/payment-method.js",
        "extractors/shipment-status.js",
        "extractors/seller.js",
        "agents/agent1-recon.js",
        "agents/agent2-strategy.js",
        "agents/agent3-executor.js",
        "agents/agent4-validator.js",
        "classifiers/category-classifier.js"
      ],
      "matches": ["https://www.amazon.ae/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
